<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SaiSms" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Matches Compose splash: white background + centered sai_logo -->
    <style name="Theme.SaiSms.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/sai_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.SaiSms</item>
    </style>
</resources>
